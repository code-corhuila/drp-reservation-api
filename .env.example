HTTP_ADDR=:8083
SERVICE_NAME=reservation-service
RESERVATION_API_NETWORK=drp-dev_default
IDENTITY_JWKS_URL=http://localhost:8081/api/v1/auth/jwks
# Inbound TB6 (payment → this API). Not a user JWT. Gateway does not route /internal/*.
PAYMENT_INTERNAL_TOKEN=change-me-tb6-payment
# Outbound to notification. Different from PAYMENT_INTERNAL_TOKEN.
NOTIFICATION_INTERNAL_TOKEN=change-me-notification-hop
# Optional local walking fallback if both hops share one secret. Empty before qa.
INTERNAL_EVENT_TOKEN=
NOTIFICATION_API_URL=http://localhost:8085
SPACE_API_URL=http://localhost:8082
# Empty = in-memory bookings and outbox. Set after Flyway on drp-reservation-db (V003 outbox).
DATABASE_URL=postgres://reservation_app:change-me-reservation@localhost:5432/drp?sslmode=disable
